POSTGRES_USER=api_user
POSTGRES_PASSWORD=change_me_target
POSTGRES_DB=apiculture_db
TARGET_POSTGRES_PORT=15432

TARGET_API_PORT=18000
TARGET_API_BASE_URL=http://localhost:18000
ENVIRONMENT=staging
DATABASE_URL=postgresql+psycopg://api_user:change_me_target@db_target:5432/apiculture_db
JWT_SECRET_KEY=change_me_target
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Mettre true uniquement pendant la beta privee : chaque nouveau compte est Premium.
BETA_NEW_USERS_PREMIUM=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:18000
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=20
API_IMAGE=beevarium-api:latest

PUBLIC_BASE_URL=https://beta.beevarium.fr
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=change_me_target
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@beevarium.fr
SMTP_FROM_NAME=Beevarium

# Sauvegarde hors site (rclone). Voir docs/06-exploitation.md
BACKUP_OFFSITE_REMOTE=beevarium-offsite:beevarium-sauvegardes
BACKUP_ENCRYPTION_PASSPHRASE=change_me_target
