POSTGRES_USER=api_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=apiculture_db
POSTGRES_PORT=5432

API_PORT=8000
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://api_user:change_me@db:5432/apiculture_db
JWT_SECRET_KEY=change_me_in_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BETA_NEW_USERS_PREMIUM=false
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=20

# Lien de reinitialisation de mot de passe
PUBLIC_BASE_URL=http://localhost:8000
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5

# SMTP: si SMTP_HOST est vide, les e-mails sont journalises au lieu d etre envoyes
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@beevarium.fr
SMTP_FROM_NAME=Beevarium
